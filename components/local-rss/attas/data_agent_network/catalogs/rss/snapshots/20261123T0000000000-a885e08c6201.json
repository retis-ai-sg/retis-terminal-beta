      "endpoint_id": "rss.read_feeds",
      "executable": true,
      "extensions": {
        "attas.http_method": "GET",
        "attas.max_response_bytes": 220000,
        "attas.schema_provenance": "curated_provider_documentation",
        "attas.specification_only": false,
        "attas.vendor_version": ""
      },
      "name": "Read feeds",
      "operation": "rss.read_feeds",
      "parameters": [
        {
          "default": null,
          "description": "The feeds to read: each a public http(s) address on the standard port, with its optional name, enabled flag, refresh interval and validators.",
          "examples": [
            [
              {
                "name": "Example",
                "url": "https://example.com/feed.xml"
              }
            ]
          ],
          "location": "body",
          "name": "feeds",
          "required": true,
          "schema": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "etag": {
                  "maxLength": 512,
                  "pattern": "^[^\r\n]*$",
                  "type": "string"
                },
                "last_modified": {
                  "maxLength": 128,
                  "pattern": "^[^\r\n]*$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 100,
                  "type": "string"
                },
                "refresh_seconds": {
                  "enum": [
                    0,
                    60,
                    300,
                    900,
                    1800,
                    3600,
                    21600,
                    86400
                  ],
                  "type": "integer"
                },
                "url": {
                  "maxLength": 2048,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        {
          "default": 20,
          "description": "The most articles to return from each feed (1 to 30).",
          "examples": [],
          "location": "body",
          "name": "limit",
          "required": false,
          "schema": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          }
        }
      ],
      "pulse_name": "",
      "quality": {
        "notes": [
          "Articles are what each feed publishes, often an excerpt; HTML becomes plain text.",
          "Feed content belongs to its publishers."
        ],
        "status": "provider_documented"
      },
      "response_schema": {
        "description": "The feeds read, in the order requested.",
        "properties": {
          "feeds": {
            "description": "One result for each feed requested.",
            "items": {
              "description": "What reading one feed gave.",
              "properties": {
                "checked_at": {
                  "description": "When the feed was read, ISO 8601 in UTC.",
                  "format": "date-time",
                  "type": "string"
                },
                "error": {
                  "description": "Why the feed could not be read.",
                  "type": "string"
                },
                "etag": {
                  "description": "ETag the publisher sent, for the next conditional read.",
                  "type": "string"
                },
                "items": {
                  "description": "The newest articles, at most `limit`.",
                  "items": {
                    "description": "One article of the feed, as plain text.",
                    "properties": {
                      "author": {
                        "description": "Author named by the entry.",
                        "type": "string"
                      },
                      "content": {
                        "description": "Article text the feed supplies (possibly an excerpt), HTML converted to plain text.",
                        "type": "string"
                      },
                      "id": {
                        "description": "Stable id of the article: a hash of the feed address and the entry guid, id, link or title.",
                        "type": "string"
                      },
                      "published_at": {
                        "description": "When the article was published or last updated, ISO 8601 in UTC.",
                        "format": "date-time",
                        "type": "string"
                      },
                      "publisher": {
                        "description": "The outlet an aggregator's entry names in its source element (RSS 2.0 <source>).",
                        "type": "string"
                      },
                      "summary": {
                        "description": "Summary or description of the article, plain text, at most 500 characters.",
                        "type": "string"
                      },
                      "title": {
                        "description": "Headline of the article, plain text.",
                        "type": "string"
                      },
                      "url": {
                        "description": "Public address of the article on the publisher's site, when the entry gives one.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "title"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "last_modified": {
                  "description": "Last-Modified the publisher sent, for the next conditional read.",
                  "type": "string"
                },
                "name": {
                  "description": "The name the user gave the feed.",
                  "type": "string"
                },
                "site_url": {
                  "description": "Public address of the feed's site.",
                  "type": "string"
                },
                "status": {
                  "description": "ready (articles read), not_modified (unchanged since the validators sent), disabled or error.",
                  "enum": [
                    "ready",
                    "not_modified",
                    "disabled",
                    "error"
                  ],
                  "type": "string"
                },
                "title": {
                  "description": "The feed's own title.",
                  "type": "string"
                },
                "truncated": {
                  "description": "True when articles were left out to keep the answer under its size limit.",
                  "type": "boolean"
                },
                "url": {
                  "description": "The feed address as requested.",
                  "type": "string"
                }
              },
              "required": [
                "url",
                "status",
                "checked_at"
              ],
              "type": "object"
            },
            "type": "array"
          },
