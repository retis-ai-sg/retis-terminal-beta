    "optional": true,
    "platforms": [
      "macos-arm64",
      "windows-x86_64",
      "linux-x86_64",
      "linux-arm64"
    ],
    "run": {
      "command": [
        "{python}",
        "-I",
        "-S",
        "-X",
        "utf8",
        "{component_dir}/start.py",
        "--state",
        "{data_dir}",
        "--port",
        "28540",
        "--health-port",
        "28541"
      ],
      "env": {
        "PROMPITS_ENV_FILE": "none",
        "PYTHON_DOTENV_DISABLED": "1"
      },
      "health_path": "/health",
      "port": 28541
    },
    "settings": [
      {
        "default": "",
        "descriptions": {
          "en": "A folder for your files, such as one on an external drive; they go into \"Retis AssetStorage\" inside it and move there at the next start. Empty: this component's own data folder.",
          "zh-Hant": "存放檔案的資料夾，例如外接磁碟上的資料夾；檔案會放在其中的「Retis AssetStorage」，並在下次啟動時移過去。留空則使用本元件自己的資料夾。"
        },
        "id": "location",
        "max_length": 400,
        "names": {
          "en": "Location",
          "zh-Hant": "儲存位置"
        },
        "pattern": "(/|~/|[A-Za-z]:[\\\\/])[^\\x00]{0,398}",
        "type": "text"
      },
      {
        "default": 20,
        "descriptions": {
          "en": "Files beyond it are refused; nothing kept is removed.",
          "zh-Hant": "超過上限的檔案會被拒絕；已保存的不會刪除。"
        },
        "id": "max_total_gb",
        "maximum": 4096,
        "minimum": 1,
        "names": {
          "en": "Storage limit (GB)",
          "zh-Hant": "儲存上限（GB）"
        },
        "type": "number"
      },
      {
        "default": 2,
        "descriptions": {
          "en": "New files are refused when the disk would have less free.",
          "zh-Hant": "若磁碟可用空間會低於此值，就不接受新檔案。"
        },
        "id": "min_free_gb",
        "maximum": 1024,
        "minimum": 1,
        "names": {
          "en": "Keep free on this disk (GB)",
          "zh-Hant": "保留磁碟可用空間（GB）"
        },
        "type": "number"
      }
    ],
    "version": "0.1.9-beta"
  },
